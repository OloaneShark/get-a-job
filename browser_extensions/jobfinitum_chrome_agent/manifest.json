{
  "manifest_version": 3,
  "name": "Jobfinitum Chrome Agent",
  "version": "0.6.9",
  "description": "Runs supported Jobfinitum Auto Apply tasks inside ordinary Chrome.",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://jobfinitum.com/*",
    "https://www.jobfinitum.com/*",
    "https://boards-api.greenhouse.io/*",
    "https://grnh.se/*",
    "https://himalayas.app/*",
    "https://www.himalayas.app/*",
    "https://remotefirstjobs.com/*",
    "https://www.remotefirstjobs.com/*",
    "https://japan-dev.com/*",
    "https://www.japan-dev.com/*",
    "https://weworkremotely.com/*",
    "https://www.weworkremotely.com/*",
    "https://jooble.org/*",
    "https://www.jooble.org/*",
    "https://remoteok.com/*",
    "https://www.remoteok.com/*",
    "https://jobicy.com/*",
    "https://www.jobicy.com/*",
    "https://tokyodev.com/*",
    "https://www.tokyodev.com/*",
    "https://*.adzuna.com/*",
    "https://*.adzuna.com.au/*",
    "https://*.adzuna.at/*",
    "https://*.adzuna.be/*",
    "https://*.adzuna.com.br/*",
    "https://*.adzuna.ca/*",
    "https://*.adzuna.fr/*",
    "https://*.adzuna.de/*",
    "https://*.adzuna.in/*",
    "https://*.adzuna.it/*",
    "https://*.adzuna.com.mx/*",
    "https://*.adzuna.nl/*",
    "https://*.adzuna.co.nz/*",
    "https://*.adzuna.pl/*",
    "https://*.adzuna.sg/*",
    "https://*.adzuna.co.za/*",
    "https://*.adzuna.es/*",
    "https://*.adzuna.ch/*",
    "https://*.adzuna.co.uk/*",
    "https://themuse.com/*",
    "https://www.themuse.com/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*"
      ],
      "js": [
        "lever_agent.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://jobfinitum.com/*",
        "https://www.jobfinitum.com/*"
      ],
      "js": [
        "site_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://grnh.se/*"
      ],
      "js": [
        "greenhouse_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://himalayas.app/*",
        "https://www.himalayas.app/*"
      ],
      "js": [
        "himalayas_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://remotefirstjobs.com/*",
        "https://www.remotefirstjobs.com/*"
      ],
      "js": [
        "remote_first_jobs_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://japan-dev.com/*",
        "https://www.japan-dev.com/*"
      ],
      "js": [
        "japan_dev_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://weworkremotely.com/*",
        "https://www.weworkremotely.com/*"
      ],
      "js": [
        "we_work_remotely_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jooble.org/*",
        "https://www.jooble.org/*"
      ],
      "js": [
        "jooble_agent.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://remoteok.com/*",
        "https://www.remoteok.com/*"
      ],
      "js": [
        "remote_ok_agent.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://jobicy.com/*",
        "https://www.jobicy.com/*"
      ],
      "js": [
        "jobicy_agent.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tokyodev.com/*",
        "https://www.tokyodev.com/*"
      ],
      "js": [
        "tokyo_dev_agent.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.adzuna.com/*",
        "https://*.adzuna.com.au/*",
        "https://*.adzuna.at/*",
        "https://*.adzuna.be/*",
        "https://*.adzuna.com.br/*",
        "https://*.adzuna.ca/*",
        "https://*.adzuna.fr/*",
        "https://*.adzuna.de/*",
        "https://*.adzuna.in/*",
        "https://*.adzuna.it/*",
        "https://*.adzuna.com.mx/*",
        "https://*.adzuna.nl/*",
        "https://*.adzuna.co.nz/*",
        "https://*.adzuna.pl/*",
        "https://*.adzuna.sg/*",
        "https://*.adzuna.co.za/*",
        "https://*.adzuna.es/*",
        "https://*.adzuna.ch/*",
        "https://*.adzuna.co.uk/*"
      ],
      "js": [
        "adzuna_agent.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://themuse.com/*",
        "https://www.themuse.com/*"
      ],
      "js": [
        "the_muse_agent.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://jobs.ashbyhq.com/*"
      ],
      "js": [
        "ashby_agent.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "webNavigation"
  ]
}
