{
  "manifest_version": 3,
  "name": "Jobfinitum Chrome Agent",
  "version": "0.6.0",
  "description": "Runs supported Jobfinitum Auto Apply tasks inside ordinary Chrome.",
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://jobfinitum.com/*",
    "https://www.jobfinitum.com/*",
    "https://boards-api.greenhouse.io/*",
    "https://himalayas.app/*",
    "https://www.himalayas.app/*",
    "https://remotefirstjobs.com/*",
    "https://www.remotefirstjobs.com/*",
    "https://jobs.ashbyhq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*"
      ],
      "js": [
        "lever_agent.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://jobfinitum.com/*",
        "https://www.jobfinitum.com/*"
      ],
      "js": [
        "site_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*"
      ],
      "js": [
        "greenhouse_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://himalayas.app/*",
        "https://www.himalayas.app/*"
      ],
      "js": [
        "himalayas_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://remotefirstjobs.com/*",
        "https://www.remotefirstjobs.com/*"
      ],
      "js": [
        "remote_first_jobs_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jobs.ashbyhq.com/*"
      ],
      "js": [
        "ashby_agent.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "storage"
  ]
}
